{
  "name": "protocolos",
  "version": "1.0.0",
  "description": "ProtocolOS — מערכת אימונים חכמה",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:copy",
    "build:js": "terser app.js --compress --mangle --output dist/app.js",
    "build:css": "cleancss -o dist/styles.css styles.css",
    "build:copy": "node scripts/copy-assets.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bke1302/fitness_app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bke1302/fitness_app/issues"
  },
  "homepage": "https://github.com/bke1302/fitness_app#readme",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.48.0",
    "vitest": "^3.2.3"
  }
}
